/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "新建(&N)\tCtrl+N",              ID_FILE_NEW
        MENUITEM "打开(&O)...\tCtrl+O",           ID_FILE_OPEN
        MENUITEM "打开文件1",                       ID_FILE1_OPEN
        MENUITEM "打开文件2",                       ID_FILE2_OPEN
        MENUITEM "打开文件3",                       ID_FILE3_OPEN
        MENUITEM "合并文件1和2",                     ID_Link
        MENUITEM SEPARATOR
        MENUITEM "保存(&S)\tCtrl+S",              ID_FILE_SAVE
        MENUITEM "另存为(&A)...",                  ID_FILE_SAVE_AS
        MENUITEM "文件1另存为",                      ID_FILE1_SAVE_AS
        MENUITEM "文件2另存为",                      ID_FILE2_SAVE_AS
        MENUITEM "文件3另存为",                      ID_FILE3_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "打印(&P)...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "打印预览(&V)",                    ID_FILE_PRINT_PREVIEW
        MENUITEM "打印设置(&R)...",                 ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "最近的文件",                       ID_FILE_MRU_FILE1
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)",                      ID_APP_EXIT
    END
    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "撤消(&U)\tCtrl+Z",              ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "剪切(&T)\tCtrl+X",              ID_EDIT_CUT
        MENUITEM "复制(&C)\tCtrl+C",              ID_EDIT_COPY
        MENUITEM "粘贴(&P)\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "曲线平移"
    BEGIN
        MENUITEM "平移语音曲线_1",                    IDM_FILE1_TRAN
        MENUITEM "平移频谱曲线_1",                    IDM_FFT1_TRAN
        MENUITEM "平移倒谱(Hz)曲线_1",                IDM_CEP1_TRAN
        MENUITEM "平移频谱(Hz)的频谱曲线_1",             ID_SpecFft1Tran
        MENUITEM "平移Mel刻度频谱曲线_1",               ID_MelSpec1Tran
        MENUITEM "平移Mel频率倒谱系数_1",               IDM_MFCC1_TRAN
        MENUITEM "平移对数振幅谱(Hz)曲线_1",             ID_LogSpec1Tran
        MENUITEM "平移倒谱法端点检测结果_1",               ID_CepDetect1Tran
        MENUITEM SEPARATOR
        MENUITEM "X方向平移",                       IDM_XPOS_TRAN
        MENUITEM "Y方向平移",                       IDM_YPOS_TRAN
        MENUITEM "停止平移",                        IDM_STOP_TRAN
        MENUITEM "还原曲线",                        IDM_RETURN_POS
        MENUITEM SEPARATOR
        MENUITEM "平移语音曲线_2",                    IDM_FILE2_TRAN
        MENUITEM "平移频谱曲线_2",                    IDM_FFT2_TRAN
        MENUITEM "平移倒谱(Hz)曲线_2",                IDM_CEP2_TRAN
        MENUITEM "平移频谱(Hz)的频谱曲线_2",             ID_SpecFft2Tran
        MENUITEM "平移Mel刻度频谱曲线_2",               ID_MelSpec2Tran
        MENUITEM "平移Mel频率倒谱系数_2",               IDM_MFCC2_TRAN
        MENUITEM "平移对数振幅谱(Hz)曲线_2",             ID_LogSpec2Tran
        MENUITEM "平移倒谱法端点检测结果_2",               ID_CepDetect2Tran
        MENUITEM SEPARATOR
        MENUITEM "平移语音曲线3",                     IDM_FILE3_TRAN
    END
    POPUP "音频播放"
    BEGIN
        MENUITEM "播放文件1",                       IDM_FILE1_PLAY
        MENUITEM "播放文件2",                       IDM_FILE2_PLAY
        MENUITEM "播放文件3",                       IDM_FILE3_PLAY
        MENUITEM "停止播放",                        IDM_STOP_PLAY
        MENUITEM SEPARATOR
        MENUITEM "取消区域选择",                      IDM_CANCEL_ZONE
    END
    POPUP "时域分析"
    BEGIN
        MENUITEM "短时能量",                        ID_POWER
        MENUITEM "短时过零率",                       ID_ZERO
        MENUITEM "平均振幅",                        ID_VIBRATION
        MENUITEM "修正的相关函数",                     ID_RCOR
        MENUITEM "基于短时自相关法的基音周期估值",             ID_ACF_Pitch
        MENUITEM "基于AMDF的基音周期估值",               ID_AMDF_Pitch
        MENUITEM "基于倒谱的基音周期估值",                 ID_CEP_Pitch
    END
    POPUP "频域分析"
    BEGIN
        MENUITEM "计算倒谱(Hz)_1",                  ID_CEPSTRUM
        MENUITEM "计算频谱(Hz)及频谱的频谱_1",            ID_TwiceFFT
        MENUITEM "计算对数振幅谱(Hz)_1",               ID_LOGSPECTRUM
        MENUITEM "计算Mel频谱及Mel频率倒谱系数_1",         ID_MelSpectrum
        MENUITEM "倒谱法端点检测",                     ID_CepDetect
        MENUITEM "保存有效帧mfcc",                   ID_SAVE_EFFECTIVE_MFCC
        MENUITEM SEPARATOR
        MENUITEM "计算倒谱(Hz)_2",                  ID_CEPSTRUM2
        MENUITEM "计算频谱(Hz)及频谱的频谱_2",            ID_TwiceFFT2
        MENUITEM "计算对数振幅谱(Hz)_2",               ID_LOGSPECTRUM2
        MENUITEM "计算Mel频谱及Mel频率倒谱系数_2",         ID_MelSpectrum2
        MENUITEM "倒谱法端点检测2",                    ID_CepDetect2
        MENUITEM SEPARATOR
        MENUITEM "功率谱",                         ID_SPECTRUM
        MENUITEM "傅里叶变换",                       ID_FFT
        MENUITEM "MFCC",                        ID_MFCC
    END
    POPUP "显示"
    BEGIN
        MENUITEM "显示语音曲线_1",                    ID_ShowWave
        MENUITEM "显示频谱曲线_1",                    ID_FFTDisplay
        MENUITEM "显示Mel刻度频谱曲线_1",               ID_MelSpectrumDisplay
        MENUITEM "显示Mel频率倒谱系数_1",               ID_MelcepDisplay
        MENUITEM "显示倒谱(Hz)曲线_1",                ID_CepDisplay
        MENUITEM "显示频谱(Hz)的频谱曲线_1",             ID_TwiceFFTDisplay
        MENUITEM "显示对数振幅谱(Hz)曲线_1",             ID_LogSpecHorizonDisplay
        MENUITEM "显示倒谱法端点检测结果_1",               ID_CepDetectDisplay1
        MENUITEM SEPARATOR
        MENUITEM "显示语音曲线_2",                    ID_ShowWave2
        MENUITEM "显示频谱曲线_2",                    ID_FFTDisplay2
        MENUITEM "显示Mel刻度频谱曲线_2",               ID_MelSpectrumDisplay2
        MENUITEM "显示Mel频率倒谱系数_2",               ID_MelcepDisplay2
        MENUITEM "显示倒谱(Hz)曲线_2",                ID_CepDisplay2
        MENUITEM "显示频谱(Hz)的频谱曲线_2",             ID_TwiceFFTDisplay2
        MENUITEM "显示对数振幅谱(Hz)曲线_2",             ID_LogSpecHorizonDisplay2
        MENUITEM "显示倒谱法端点检测结果_2",               ID_CepDetectDisplay2
        MENUITEM SEPARATOR
        MENUITEM "显示综合的语谱图",                    ID_MutiDisplay
        MENUITEM "显示功率谱语谱图",                    ID_SpectrumDisplay
        MENUITEM "显示对数功率谱语谱图",                  ID_DRAWYPT
        MENUITEM "基音周期分布",                      ID_SHOWPITCH
    END
    POPUP "帧长设置"
    BEGIN
        MENUITEM "256",                         ID_Frmlen256
        MENUITEM "512",                         ID_Frmlen512
        MENUITEM "1024",                        ID_Frmlen1024
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "关于 MyWave(&A)...",            ID_APP_ABOUT
    END
END


